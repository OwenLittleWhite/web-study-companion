# Never put these values in the browser extension.
DASHSCOPE_API_KEY=

# Qwen streaming ASR. Use the endpoint shown for your Alibaba Cloud/Qwen region.
QWEN_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming

# Default Qwen-compatible text API used for Session Q&A. It can also be configured in the side panel.
QWEN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_LLM_MODEL=qwen-plus

# Local server and storage.
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8765
COMPANION_DATA_DIR=./data
FUNASR_MODEL=paraformer-zh-streaming
FUNASR_DEVICE=cuda:0
FUNASR_PRELOAD=true
